# Server environment variables (copy to Render dashboard → Environment)
# All are REQUIRED in production except GOOGLE_CLIENT_ID (unused).

# MongoDB connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/periano-grill

# Comma/space-separated list of allowed front-end origins (CORS)
# Set this to your Netlify URL, e.g. https://periano-grill.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (Render sets this automatically)
PORT=10000
